// ============================================================================
// FoodCFO — Schéma de base de données (Prisma / PostgreSQL)
// ============================================================================
// Décisions de cadrage appliquées (Phase 0, validées le 22/07/2026) :
// - Multi-tenant "invisible" : restaurantId présent sur toutes les entités
//   métier dès le début, même si l'UI n'affiche qu'un seul restaurant pour
//   l'instant. Aucune migration de refonte ne sera nécessaire plus tard.
// - 3 rôles utilisateurs : GERANT / CUISINE / SERVICE.
// - Seuils de marge par défaut configurables par restaurant (70% / 60%).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

// 3 rôles simples (décision 0.5). GERANT a accès à tout, y compris la
// gestion des utilisateurs et les paramètres du restaurant.
enum UserRole {
  GERANT
  CUISINE
  SERVICE
}

// Canal de commande préféré d'un fournisseur — reflète la réalité terrain
// (le prompt métier précise que beaucoup de fournisseurs utilisent encore
// le téléphone ou le fax).
enum OrderChannel {
  EMAIL
  PHONE
  SMS
  WHATSAPP
  WEB_PORTAL
  FAX
}

// Unité de mesure des produits achetés. On distingue le poids/volume
// (nécessaire pour calculer un coût matière précis par recette) des
// unités entières (ex: une bouteille, une pièce).
enum ProductUnit {
  KG
  G
  L
  ML
  UNITE
}

// Taux de TVA français applicables en restauration (le taux exact dépend
// du plat : sur place vs à emporter vs alcool). Stocké en pourcentage.
enum VatRate {
  TAUX_5_5
  TAUX_10
  TAUX_20
}

// Les 14 allergènes à déclaration obligatoire en France/UE (règlement
// INCO). Stockés comme un tableau d'enum sur MenuItem plutôt qu'une table
// de jointure séparée : la liste est fixe et réglementaire, ça évite une
// jointure supplémentaire sur une requête très fréquente (affichage carte).
enum Allergen {
  GLUTEN
  CRUSTACES
  OEUFS
  POISSON
  ARACHIDES
  SOJA
  LAIT
  FRUITS_A_COQUE
  CELERI
  MOUTARDE
  SESAME
  SULFITES
  LUPIN
  MOLLUSQUES
}

// Statut du traitement d'une facture scannée. PENDING_REVIEW = l'OCR a
// répondu mais un humain doit valider avant que les prix impactent les
// marges (règle métier explicite : ne jamais faire confiance à 100% à
// l'OCR).
enum InvoiceStatus {
  UPLOADED
  PROCESSING
  PENDING_REVIEW
  VALIDATED
  ERROR
}

enum OrderStatus {
  DRAFT
  SENT
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum WasteReason {
  PERIME
  ERREUR_PREPARATION
  INVENDU
  AUTRE
}

// Deux types d'alertes distincts car deux règles métier différentes
// (seuil de marge franchi vs hausse de prix fournisseur détectée).
enum MarginAlertType {
  MARGIN_BELOW_THRESHOLD
  SUPPLIER_PRICE_INCREASE
}

enum MarginAlertStatus {
  ACTIVE
  RESOLVED
  DISMISSED
}

// Reflète directement les statuts d'abonnement Stripe (Subscription.status)
// plutôt qu'un statut simplifié maison — évite toute logique de mapping
// à maintenir en double, la synchronisation par webhook peut recopier
// la valeur telle quelle.
enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

// ============================================================================
// PHASE 7 — ENUMS (Planning, Hygiène, Contrôle — 31/07/2026)
// ============================================================================

// Jour de la semaine pour les règles récurrentes (disponibilités,
// besoins de staffing). Enum plutôt qu'un entier brut (0-6) : évite toute
// ambiguïté sur le jour représenté par 0, cohérent avec le reste du
// fichier qui préfère des enums explicites aux valeurs magiques.
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// DRAFT = généré automatiquement, pas encore vu par un humain ou en
// cours d'ajustement. VALIDATED = confirmé par le restaurateur, devient
// la version définitive transmise aux équipes. Jamais l'inverse : une
// fois validé, on ne repasse pas en brouillon (on génère un nouveau
// planning si besoin) — même philosophie que InvoiceStatus.VALIDATED
// (Phase 3), verrouillé côté serveur une fois franchi.
enum ScheduleStatus {
  DRAFT
  VALIDATED
}

// Les organismes qui contrôlent réellement un restaurant en France
// (identifiés et expliqués à l'utilisateur avant cadrage, voir journal
// du 31/07/2026). Enum plutôt qu'une table : liste fixe et réglementaire,
// même raisonnement que Allergen ci-dessus.
enum ControlOrganism {
  URSSAF
  DDPP
  DGCCRF
  DGFIP
  INSPECTION_TRAVAIL
}

// ============================================================================
// RESTAURANT — racine du multi-tenant
// ============================================================================

model Restaurant {
  id       String @id @default(uuid())
  name     String
  currency String @default("EUR")
  timezone String @default("Europe/Paris")

  // Seuils de marge par défaut : vert ≥ marginGreenThreshold,
  // orange entre marginOrangeThreshold et marginGreenThreshold,
  // rouge < marginOrangeThreshold. Configurables par le gérant
  // (décision 0.6 : valeurs par défaut 70% / 60%, jamais figées en dur
  // ailleurs dans le code applicatif).
  marginGreenThreshold  Decimal @default(70) @db.Decimal(5, 2)
  marginOrangeThreshold Decimal @default(60) @db.Decimal(5, 2)

  // Seuil (en %) au-delà duquel une hausse de prix fournisseur entre deux
  // factures déclenche une alerte automatique. Configurable, pas figé.
  priceIncreaseAlertThreshold Decimal @default(10) @db.Decimal(5, 2)

  // Abonnement (Stripe) — un abonnement par restaurant, cohérent avec le
  // modèle multi-restaurant existant (Restaurant, pas User, est déjà
  // l'unité de facturation naturelle : un Gérant avec plusieurs
  // restaurants peut vouloir n'en payer qu'un seul). Tous nullable : un
  // restaurant fraîchement créé n'a encore initié aucun paiement.
  stripeCustomerId             String?             @unique
  stripeSubscriptionId         String?             @unique
  subscriptionStatus           SubscriptionStatus?
  subscriptionCurrentPeriodEnd DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  suppliers    Supplier[]
  products     Product[]
  menuItems    MenuItem[]
  invoices     Invoice[]
  orders       Order[]
  wasteEntries WasteEntry[]
  marginAlerts MarginAlert[]

  // Phase 7 (31/07/2026)
  employeeAvailabilities       EmployeeAvailability[]
  staffingRequirements         StaffingRequirement[]
  schedules                    Schedule[]
  hygieneReferenceItems        HygieneReferenceItem[]
  cleaningChecklistTemplates   CleaningChecklistTemplate[]
  cleaningChecklistCompletions CleaningChecklistCompletion[]
  controlDocuments             ControlDocument[]

  @@map("restaurants")
}

// ============================================================================
// USER — rattaché à un restaurant, rôle simplifié à 3 niveaux
// ============================================================================

model User {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  email        String
  passwordHash String
  role         UserRole
  firstName    String
  lastName     String
  isActive     Boolean  @default(true)

  // Renseigné uniquement pour le Gérant fondateur, au moment du
  // bootstrap (acceptation des CGU obligatoire pour créer un compte) —
  // `null` pour les membres d'équipe ajoutés ensuite par leur Gérant,
  // qui n'ont pas eux-mêmes traversé cet écran.
  termsAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  wasteEntries  WasteEntry[]

  // Phase 7 (31/07/2026) — voir le commentaire sur ShiftAssignment.userId
  // (onDelete: Restrict) : un utilisateur ayant des heures de travail
  // enregistrées ne peut pas être supprimé directement (registre légal),
  // contrairement à ses simples règles de disponibilité (Cascade).
  employeeAvailabilities       EmployeeAvailability[]
  shiftAssignments             ShiftAssignment[]
  validatedSchedules           Schedule[]
  cleaningChecklistCompletions CleaningChecklistCompletion[]
  controlDocuments             ControlDocument[]

  // L'email doit être unique par restaurant (pas globalement : deux
  // restaurants distincts pourraient en théorie avoir un utilisateur
  // avec la même adresse email s'ils sont gérés séparément — rare, mais
  // évite une contrainte globale artificielle).
  @@unique([restaurantId, email])
  @@index([restaurantId])
  @@map("users")
}

// Refresh tokens stockés en base pour pouvoir les révoquer individuellement
// (déconnexion, changement de mot de passe, compromission suspectée).
model RefreshToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Rattaché à l'email, pas à un userId précis : un compte multi-restaurant
// (voir User) a une ligne par restaurant mais un seul mot de passe
// partagé — réinitialiser doit mettre à jour toutes ces lignes à la
// fois, pas une seule, sous peine de mots de passe désynchronisés entre
// les restaurants d'un même compte.
model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

// ============================================================================
// SUPPLIER — fournisseurs (boucher, poissonnier, primeur, caviste...)
// ============================================================================

model Supplier {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name             String
  category         String // libre (ex: "Boucherie", "Poissonnerie", "Grossiste")
  preferredChannel OrderChannel
  contactEmail     String?
  contactPhone     String?
  notes            String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products     Product[]
  priceHistory PriceHistory[]
  invoices     Invoice[]
  orders       Order[]

  @@index([restaurantId])
  @@map("suppliers")
}

// ============================================================================
// PRODUCT — produit acheté à un fournisseur
// ============================================================================

model Product {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  name String
  unit ProductUnit

  // Dernier prix HT connu — dénormalisé volontairement pour éviter de
  // recalculer à chaque affichage de fiche technique ; la valeur de
  // référence "source de vérité" reste PriceHistory, ce champ n'est
  // qu'un cache mis à jour à chaque nouvelle entrée d'historique.
  currentPriceHT Decimal @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceHistory      PriceHistory[]
  recipeIngredients RecipeIngredient[]
  invoiceLineItems  InvoiceLineItem[]
  orderLineItems    OrderLineItem[]
  wasteEntries      WasteEntry[]

  @@index([restaurantId])
  @@index([supplierId])
  @@map("products")
}

// ============================================================================
// PRICE_HISTORY — historique des prix, pour détecter les hausses
// ============================================================================

model PriceHistory {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  priceHT Decimal @db.Decimal(10, 4)

  // Lien optionnel vers la facture qui a généré cette entrée de prix
  // (traçabilité : "pourquoi ce prix a-t-il changé ?").
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  recordedAt DateTime @default(now())

  // Requête très fréquente : "historique de prix d'un produit, du plus
  // récent au plus ancien" → index composite.
  @@index([productId, recordedAt])
  @@map("price_history")
}

// ============================================================================
// MENU_ITEM — plat à la carte
// ============================================================================

model MenuItem {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name            String
  category        String // libre (ex: "Entrées", "Plats", "Desserts", "Boissons")
  sellingPriceTTC Decimal    @db.Decimal(10, 2)
  vatRate         VatRate
  isActive        Boolean    @default(true)
  allergens       Allergen[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Une fiche technique par plat (relation 1-1). Optionnelle : un plat
  // peut exister sans fiche technique encore renseignée (onboarding
  // progressif), mais aucune marge ne peut être calculée tant qu'elle
  // n'existe pas.
  recipe Recipe?

  wasteEntries WasteEntry[]
  marginAlerts MarginAlert[]

  @@index([restaurantId])
  @@index([restaurantId, isActive])
  @@map("menu_items")
}

// ============================================================================
// RECIPE / RECIPE_INGREDIENT — fiche technique
// ============================================================================

model Recipe {
  id         String   @id @default(uuid())
  menuItemId String   @unique
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id       String @id @default(uuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Quantité du produit utilisée dans la recette, dans l'unité du produit
  // (cohérence garantie par Product.unit — pas de re-saisie d'unité ici).
  quantity Decimal @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un produit ne doit apparaître qu'une fois par recette (sinon on
  // additionne les quantités au lieu de créer deux lignes).
  @@unique([recipeId, productId])
  @@index([productId])
  @@map("recipe_ingredients")
}

// ============================================================================
// INVOICE / INVOICE_LINE_ITEM — factures fournisseurs scannées
// ============================================================================

model Invoice {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  status InvoiceStatus @default(UPLOADED)

  invoiceDate DateTime?
  totalAmount Decimal?  @db.Decimal(10, 2)

  // Fichier source (PDF/JPG) stocké directement en base plutôt que sur
  // le disque du conteneur : le service backend Railway n'a aucun
  // volume persistant attaché (contrairement à Postgres) — un fichier
  // écrit sur disque serait perdu au prochain redéploiement (bug réel
  // détecté et corrigé le 26/07/2026, avant toute vraie donnée en
  // production). Stocker en base a aussi l'avantage d'être couvert
  // automatiquement par les sauvegardes automatiques (backup/) au même
  // titre que le reste des données.
  sourceFileData     Bytes
  sourceFileMimeType String

  // Réponse brute de l'extraction IA (API Claude vision), conservée pour
  // audit et pour ré-analyser sans re-uploader si le parsing évolue.
  rawExtractionJson Json?

  // Renseigné si status = ERROR, pour diagnostiquer sans deviner.
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems    InvoiceLineItem[]
  priceHistory PriceHistory[]

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@map("invoices")
}

model InvoiceLineItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // productId nullable : au moment de l'extraction OCR, le produit n'est
  // pas encore rapproché du catalogue interne — c'est justement ce que
  // l'écran de validation humaine (Phase 3) doit faire.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Libellé brut tel qu'extrait de la facture, avant rapprochement —
  // toujours conservé même après rapprochement, pour audit.
  rawLabel String

  quantity     Decimal @db.Decimal(10, 4)
  unitPriceHT  Decimal @db.Decimal(10, 4)
  totalPriceHT Decimal @db.Decimal(10, 2)

  // A été revu/corrigé manuellement par un utilisateur avant validation ?
  wasManuallyEdited Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_line_items")
}

// ============================================================================
// ORDER / ORDER_LINE_ITEM — commandes fournisseurs envoyées
// ============================================================================

model Order {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  status      OrderStatus @default(DRAFT)
  sentAt      DateTime?
  confirmedAt DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems OrderLineItem[]

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@map("orders")
}

model OrderLineItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Quantité suggérée automatiquement (basée sur l'historique de
  // commande) vs quantité réellement commandée après ajustement humain —
  // deux champs distincts pour pouvoir mesurer la fiabilité des
  // suggestions dans le temps.
  suggestedQuantity Decimal? @db.Decimal(10, 4)
  quantity          Decimal  @db.Decimal(10, 4)

  @@index([orderId])
  @@index([productId])
  @@map("order_line_items")
}

// ============================================================================
// WASTE_ENTRY — gaspillage et pertes
// ============================================================================

model WasteEntry {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Une perte concerne soit un produit brut (ex: poisson périmé), soit
  // un plat fini (ex: assiette invendue) — les deux sont optionnels mais
  // au moins l'un des deux doit être renseigné (contrainte applicative,
  // pas modélisable proprement en Prisma seul).
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  quantity       Decimal     @db.Decimal(10, 4)
  estimatedValue Decimal     @db.Decimal(10, 2)
  reason         WasteReason

  declaredById String
  declaredBy   User   @relation(fields: [declaredById], references: [id], onDelete: Restrict)

  declaredAt DateTime @default(now())

  // Requête fréquente : "gaspillage du mois, par restaurant" pour la
  // Phase 5 (stats par catégorie / impact chiffré sur la marge).
  @@index([restaurantId, declaredAt])
  @@map("waste_entries")
}

// ============================================================================
// MARGIN_ALERT — alertes automatiques
// ============================================================================

model MarginAlert {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  type   MarginAlertType
  status MarginAlertStatus @default(ACTIVE)

  // Valeurs numériques au moment du déclenchement, pour affichage direct
  // sans recalcul ("marge tombée à 54%, seuil rouge à 60%").
  thresholdValue Decimal @db.Decimal(10, 4)
  currentValue   Decimal @db.Decimal(10, 4)

  message String // message lisible généré à la création, pas recalculé à l'affichage

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  // Requête très fréquente : "alertes actives d'un restaurant" pour le
  // tableau de bord.
  @@index([restaurantId, status])
  @@map("margin_alerts")
}

// ============================================================================
// PHASE 7 — PLANNING (31/07/2026)
// ============================================================================
// Cadrage complet dans FoodCFO_PLAN.md (section "PHASE 7") et le journal
// de bord (entrée du 31/07/2026) : le restaurateur saisit ses besoins de
// staffing et les règles de disponibilité de ses employés, un générateur
// propose un planning complet respectant ces contraintes + le socle
// légal stable (repos quotidien/hebdomadaire, durées maximales), puis un
// humain valide ou ajuste avant que ça devienne définitif — jamais
// appliqué sans validation humaine (même principe que l'extraction IA
// des factures, Phase 3).

// Une règle = une indisponibilité (le défaut est "disponible" ; on ne
// modélise que les exceptions, pas des fenêtres de disponibilité
// complexes — plus simple et suffisant pour ce qui a été demandé).
// Récurrente (weekday renseigné, ex: "tous les mercredis") ou ponctuelle
// (specificDate renseigné, ex: "le 15 août"), jamais les deux à la fois —
// contrainte applicative (comme WasteEntry.productId/menuItemId
// ci-dessus), pas modélisable proprement en Prisma seul.
model EmployeeAvailability {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekday      Weekday?
  specificDate DateTime?
  reason       String?

  createdAt DateTime @default(now())

  @@index([restaurantId, userId])
  @@map("employee_availabilities")
}

// Gabarit hebdomadaire des besoins de couverture (ex: "tous les lundis,
// service midi 11h-15h, il faut 2 CUISINE + 1 SERVICE") — réutilisé
// d'une semaine sur l'autre par le générateur plutôt que ressaisi à
// chaque fois, cohérent avec le fonctionnement réel d'un restaurant où
// le besoin de base change rarement.
model StaffingRequirement {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  weekday       Weekday
  role          UserRole
  startTime     DateTime @db.Time
  endTime       DateTime @db.Time
  requiredCount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, weekday])
  @@map("staffing_requirements")
}

// Un planning généré pour une période donnée (typiquement une semaine).
// DRAFT tant que le restaurateur ne l'a pas validé — jamais transmis aux
// équipes tel quel avant validation humaine explicite.
model Schedule {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime
  status      ScheduleStatus @default(DRAFT)

  // Secondaire (traçabilité "qui a validé"), pas le cœur de la donnée —
  // SetNull plutôt que Restrict : si l'utilisateur qui a validé est
  // supprimé plus tard, le planning validé reste valide et exploitable,
  // contrairement aux ShiftAssignment qui sont eux le registre légal des
  // heures réellement travaillées (Restrict, voir ci-dessous).
  validatedById String?
  validatedBy   User?     @relation(fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt   DateTime?

  generatedAt DateTime @default(now())

  shiftAssignments ShiftAssignment[]

  @@index([restaurantId, periodStart])
  @@map("schedules")
}

// Une ligne = un créneau travaillé par un employé. `wasManuallyAdjusted`
// permet de mesurer dans le temps la fiabilité du générateur (combien de
// créneaux proposés sont acceptés tels quels vs modifiés à la main).
// `actualStartTime`/`actualEndTime`/`isAbsent` permettent de corriger
// après coup (retard, absence) sans perdre la trace de ce qui était
// prévu à l'origine — c'est la version "actuelle" qui alimente le
// récapitulatif d'heures pour le comptable, jamais la version prévue
// seule.
model ShiftAssignment {
  id         String   @id @default(uuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  // Restrict, pas Cascade : une ligne de planning devenue un créneau
  // réellement travaillé est un registre d'heures, potentiellement
  // demandé lors d'un contrôle Inspection du travail/URSSAF (Phase 7.4)
  // — même logique que WasteEntry.declaredBy. Supprimer un utilisateur
  // ayant des heures enregistrées n'est possible qu'en désactivant son
  // compte (isActive, déjà le mécanisme existant partout ailleurs), pas
  // en le supprimant réellement, sauf suppression RGPD complète du
  // restaurant (deleteRestaurant devra supprimer les ShiftAssignment
  // avant les User, comme il le fait déjà pour WasteEntry).
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  role      UserRole
  date      DateTime
  startTime DateTime @db.Time
  endTime   DateTime @db.Time

  wasManuallyAdjusted Boolean   @default(false)
  actualStartTime     DateTime? @db.Time
  actualEndTime       DateTime? @db.Time
  isAbsent            Boolean   @default(false)
  absenceNote         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId])
  @@index([userId, date])
  @@map("shift_assignments")
}

// ============================================================================
// PHASE 7 — HYGIÈNE (31/07/2026)
// ============================================================================
// Deux fonctionnalités distinctes dans une même rubrique : du contenu de
// référence (rappels/normes, fourni par le restaurateur, pas généré) et
// une checklist de fin de service cochable.

// Un rappel/une norme, avec média optionnel. Stocké en base (Bytes),
// même choix que Invoice.sourceFileData : le service backend Railway n'a
// aucun volume persistant, un fichier écrit sur disque serait perdu au
// prochain redéploiement — et ça reste couvert par les sauvegardes
// automatiques existantes, contrairement à un stockage disque.
model HygieneReferenceItem {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  title   String
  content String

  mediaData     Bytes?
  mediaMimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@map("hygiene_reference_items")
}

// Le gabarit de checklist (ex: "Fin de service midi", "Fin de service
// soir") — un restaurant peut en avoir plusieurs selon le service/la
// zone. Rempli une fois, réutilisé à chaque complétion, comme Recipe
// pour les fiches techniques.
model CleaningChecklistTemplate {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       CleaningChecklistTemplateItem[]
  completions CleaningChecklistCompletion[]

  @@index([restaurantId])
  @@map("cleaning_checklist_templates")
}

model CleaningChecklistTemplateItem {
  id         String                    @id @default(uuid())
  templateId String
  template   CleaningChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  label String
  order Int

  completionItems CleaningChecklistCompletionItem[]

  @@index([templateId])
  @@map("cleaning_checklist_template_items")
}

// Une complétion = une exécution réelle du gabarit pour un service
// donné. `completedAt` reste null tant que tous les items ne sont pas
// cochés — c'est justement le but demandé : pas de doute possible sur un
// élément oublié, la complétion n'est "faite" que si tout y est.
model CleaningChecklistCompletion {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  templateId String
  // Restrict : l'historique de complétion (potentiellement demandé lors
  // d'un contrôle DDPP, Phase 7.4) doit survivre même si le gabarit
  // évolue — on ne supprime pas un gabarit déjà utilisé, comme Product
  // vis-à-vis de RecipeIngredient.
  template   CleaningChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  serviceDate DateTime

  // Restrict, même raisonnement que WasteEntry.declaredBy et
  // ShiftAssignment.userId : registre potentiellement demandé en
  // contrôle, pas supprimable via un simple hard-delete utilisateur.
  completedById String
  completedBy   User   @relation(fields: [completedById], references: [id], onDelete: Restrict)

  completedAt DateTime?
  createdAt   DateTime  @default(now())

  items CleaningChecklistCompletionItem[]

  @@index([restaurantId, serviceDate])
  @@map("cleaning_checklist_completions")
}

model CleaningChecklistCompletionItem {
  id           String                      @id @default(uuid())
  completionId String
  completion   CleaningChecklistCompletion @relation(fields: [completionId], references: [id], onDelete: Cascade)

  templateItemId String
  templateItem   CleaningChecklistTemplateItem @relation(fields: [templateItemId], references: [id], onDelete: Restrict)

  isChecked Boolean   @default(false)
  checkedAt DateTime?

  @@unique([completionId, templateItemId])
  @@index([completionId])
  @@map("cleaning_checklist_completion_items")
}

// ============================================================================
// PHASE 7 — CONTRÔLE (31/07/2026)
// ============================================================================
// Espace de dépôt de documents, catégorisé par organisme de contrôle.
// Le "dossier" présenté au restaurateur (Phase 7.4) n'est pas un modèle
// à part : c'est une agrégation à la lecture de ces documents déposés +
// des données déjà en base ailleurs (récapitulatif d'heures de
// ShiftAssignment pour URSSAF/Inspection du travail, historique de
// CleaningChecklistCompletion pour DDPP) — pas de duplication de données.
model ControlDocument {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  organism ControlOrganism
  // Libre plutôt qu'un enum : les catégories exactes par organisme sont
  // encore en cours de définition (voir FoodCFO_PLAN.md, Phase 7.4) et
  // vont probablement évoluer — un enum figerait la liste et demanderait
  // une migration à chaque ajustement, alors qu'un champ texte suffit
  // (même raisonnement que Supplier.category).
  category String
  label    String

  fileData     Bytes
  fileMimeType String

  // Restrict, même raisonnement que les autres champs "qui a fait cette
  // action" de la Phase 7 : un document déposé en vue d'un contrôle ne
  // doit pas disparaître silencieusement si l'utilisateur qui l'a
  // déposé est supprimé.
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  uploadedAt DateTime @default(now())

  @@index([restaurantId, organism])
  @@map("control_documents")
}
