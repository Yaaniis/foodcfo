# Copier ce fichier en .env (jamais commité) et adapter les valeurs.

# --- Base de données (correspond au docker-compose.yml en local) ---
DATABASE_URL="postgresql://foodcfo:foodcfo_dev_password@localhost:5432/foodcfo?schema=public"

# --- Authentification ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- API Claude (OCR de factures — Phase 3) ---
ANTHROPIC_API_KEY="sk-ant-xxxxx"

# --- Email transactionnel (décision 0.7 : Resend) ---
RESEND_API_KEY="re_xxxxx"
RESEND_FROM_EMAIL="commandes@votre-domaine.fr"

# --- WhatsApp Business (API Cloud de Meta) — envoi de commande quand le
# canal préféré du fournisseur (Supplier.preferredChannel) est WHATSAPP ---
WHATSAPP_ACCESS_TOKEN="xxxxx"
WHATSAPP_PHONE_NUMBER_ID="xxxxx"

# --- SMS (Twilio) — envoi de commande quand le canal préféré du
# fournisseur est SMS ---
TWILIO_ACCOUNT_SID="ACxxxxx"
TWILIO_AUTH_TOKEN="xxxxx"
TWILIO_FROM_NUMBER="+15551234567"

# --- Backend ---
PORT=3001
NODE_ENV="development"

# --- Frontend ---
VITE_API_BASE_URL="http://localhost:3001"
